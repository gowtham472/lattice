# /etc/lattice/lattice.env (mode 0600, owned by root)
#
# Address the cockpit listens on. Anything but loopback requires users (see lattice.service)
# or LATTICE_TOKEN.
LATTICE_BIND=127.0.0.1:7443
# A directory scans may read, as NAME=PATH. It is mounted read-only for the service.
LATTICE_ROOT=estate=/srv/code
# A single admin bearer token, when no users file is configured; prefer named users:
#   lattice token --name alice --role operator --users /etc/lattice/users.toml
#LATTICE_TOKEN=
LATTICE_LOG=info
# Incremental scans: unchanged files are not parsed again (inside the state directory)
LATTICE_CACHE=/var/lib/lattice/cache
# Signed knowledge bundles (optional): install with
#   lattice knowledge install bundle.json --knowledge-dir /var/lib/lattice/knowledge \
#       --knowledge-key /etc/lattice/knowledge.pub
# An installed bundle that does not verify stops the service from starting.
#LATTICE_KNOWLEDGE_DIR=/var/lib/lattice/knowledge
#LATTICE_KNOWLEDGE_KEY=/etc/lattice/knowledge.pub
