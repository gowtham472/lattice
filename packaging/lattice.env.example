# /etc/lattice/lattice.env (mode 0600, owned by root)
#
# Address the cockpit listens on. Anything but loopback requires LATTICE_TOKEN.
LATTICE_BIND=127.0.0.1:7443
# A directory scans may read, as NAME=PATH. It is mounted read-only for the service.
LATTICE_ROOT=estate=/srv/code
# Bearer token for the API; generate with: head -c 32 /dev/urandom | base64
#LATTICE_TOKEN=
LATTICE_LOG=info
